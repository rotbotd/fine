// Fine generates one constructor branch and one exact direct-field IH. Z3 still
// unfolds the recursive definition and closes the branch formulas. This one-
// parameter fixture needs no generalized quantified IH.
enum List {
  nil,
  cons(head: Int, tail: List),
}

function length(xs: List): Int {
  match xs {
    nil => 0,
    cons(_, tail) => 1 + length(tail),
  }
}

check length_nonnegative(xs: List) {
  inducts(xs);
  assumes {}
  ensures {
    length(xs) >= 0;
  }
}
