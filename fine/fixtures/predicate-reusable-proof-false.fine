enum Tm {
  atom,
  mark,
  wrap(body: Tm),
}

predicate Step(before: Tm, after: Tm) {
  constructor root() {
    takes {}
    gives Step(atom, mark);
  }

  constructor under(before: Tm, after: Tm) {
    takes {
      Step(before, after);
    }
    gives Step(wrap(before), wrap(after));
  }
}

proof step_equal(before: Tm, after: Tm) {
  inducts(Step(before, after));
  assumes {
    Step(before, after);
  }
  ensures {
    before == after;
  }
}

check unreachable(value: Tm) {
  assumes {}
  ensures {
    value == value;
  }
}
