enum Nat {
  zero,
  succ(Nat),
}

function even(value: Nat) -> Bool {
  match value {
    zero => true,
    succ(previous) => odd(previous),
  }
}

function odd(value: Nat) -> Bool {
  match value {
    zero => false,
    succ(previous) => even(previous),
  }
}

function four_even() -> Bool {
  // The wrapper is the exact-input staging request.
