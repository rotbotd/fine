enum Tm {
  bound(index: Int),
  free(name: Int),
  app(fn: Tm, argument: Tm),
  abs(body: Tm),
}

function open_at(term: Tm, depth: Int, fresh: Int): Tm {
  match term {
    bound(index) => if index == depth { free(fresh) } else { bound(index) },
    free(name) => free(name),
    app(fn, argument) => app(open_at(fn, depth, fresh), open_at(argument, depth, fresh)),
    abs(body) => abs(open_at(body, depth + 1, fresh)),
  }
}

function support_cutoff(term: Tm): Int {
  match term {
    bound(_) => 0,
    free(name) => name,
    app(fn, argument) => if support_cutoff(fn) >= support_cutoff(argument) {
      support_cutoff(fn)
    } else {
      support_cutoff(argument)
    },
    abs(body) => support_cutoff(body),
  }
}

view FreshFor(before: Tm, after: Tm) over Int {
  requires {
    value >= support_cutoff(before) + 1;
    value >= support_cutoff(after) + 1;
  }
  witness if support_cutoff(before) >= support_cutoff(after) {
    support_cutoff(before) + 1
  } else {
    support_cutoff(after) + 1
  };
}

predicate Step(before: Tm, after: Tm) {
  constructor root() {
    takes {}
    gives Step(bound(0), free(0));
  }

  constructor under_abs(before: Tm, after: Tm) {
    takes {
      arbitrary fresh: FreshFor(before, after) {
        Step(open_at(before, 0, fresh), open_at(after, 0, fresh));
      }
    }
    gives Step(abs(before), abs(after));
  }
}

check distinct_indices(before: Tm, after: Tm) {
  inducts(Step(before, after));
  assumes {
    Step(before, after);
  }
  ensures {
    (before == after) == false;
  }
}
