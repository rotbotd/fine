// Control: At expects its parameter, but the declared successor witness violates it.
// One-layer predicate use must reject the unavailable field instead of closing vacuously.
enum Nat {
  zero,
  succ(previous: Nat),
}

view At(expected: Nat) over Nat {
  requires {
    value == expected;
  }
  witness succ(expected);
}

predicate Marked(value: Nat) {
  constructor base() {
    takes {}
    gives Marked(zero);
  }

  constructor grow(value: Nat) {
    takes {
      arbitrary token: At(value) {
        Marked(token);
      }
    }
    gives Marked(succ(succ(value)));
  }
}

predicate Step(before: Nat, after: Nat) {
  constructor root() {
    takes {}
    gives Step(zero, succ(succ(zero)));
  }

  constructor under(before: Nat, after: Nat) {
    takes { Step(before, after); }
    gives Step(succ(succ(before)), succ(succ(after)));
  }
}

check invalid_marked_preservation(before: Nat, after: Nat) {
  inducts(Step(before, after));
  assumes {
    Step(before, after);
    Marked(before);
  }
  ensures { Marked(after); }
}
