// The recursive branch name lives strictly above cutoff + 2, while the closed
// result uses cutoff + 1. The close branch can therefore succeed only by
// transporting its total recursive IH through the separately proved Named
// renaming theorem; direct same-binder instantiation is impossible.
enum Body {
  hole(cutoff: Int),
}

enum Stage {
  raw(body: Body),
  sealed(body: Body),
}

enum Tm {
  variable(name: Int),
  boxed(body: Tm),
}

function open(body: Body, name: Int): Tm {
  match body {
    hole(_) => variable(name),
  }
}

function support_cutoff(body: Body): Int {
  match body {
    hole(cutoff) => cutoff,
  }
}

function rename(term: Tm, source: Int, target: Int): Tm {
  match term {
    variable(name) => if name == source { variable(target) } else { variable(name) },
    boxed(body) => boxed(rename(body, source, target)),
  }
}

predicate Named(name: Int, term: Tm) {
  constructor variable_case(name: Int) {
    takes {}
    gives Named(name, variable(name));
  }

  constructor boxed_case(name: Int, body: Tm) {
    takes { Named(name, body); }
    gives Named(name, boxed(body));
  }
}

proof named_rename(name: Int, term: Tm, other: Int) {
  inducts(Named(name, term));
  assumes { Named(name, term); }
  ensures { Named(other, rename(term, name, other)); }
}

view BranchFresh(body: Body) over Int {
  requires { value >= support_cutoff(body) + 2; }
  witness support_cutoff(body) + 2;
}

predicate Transport(stage: Stage, name: Int, term: Tm) {
  constructor opened(body: Body, name: Int) {
    takes {}
    gives Transport(raw(body), name, open(body, name));
  }

  constructor close(body: Body) {
    takes {
      arbitrary branch_name: BranchFresh(body) {
        Transport(raw(body), branch_name, open(body, branch_name));
      }
    }
    gives Transport(
      sealed(body),
      support_cutoff(body) + 1,
      boxed(open(body, support_cutoff(body) + 1))
    );
  }
}

proof transport_named(stage: Stage, name: Int, term: Tm) {
  inducts(Transport(stage, name, term));
  assumes { Transport(stage, name, term); }
  ensures { Named(name, term); }
}

predicate Request(stage: Stage, name: Int, term: Tm) {
  constructor requested(stage: Stage, name: Int, term: Tm) {
    takes {}
    gives Request(stage, name, term);
  }
}

check use_transport(stage: Stage, name: Int, term: Tm) {
  inducts(Request(stage, name, term));
  assumes {
    Request(stage, name, term);
    Transport(stage, name, term);
  }
  ensures { Named(name, term); }
}
