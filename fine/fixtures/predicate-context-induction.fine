// The recursive IH must quantify over `ceiling`. In the `under` branch Z3
// instantiates it at `ceiling - 1`; carrying only the source occurrence of
// `ceiling` would leave the branch open.
enum Nat {
  zero,
  succ(previous: Nat),
}

function height(value: Nat): Int {
  match value {
    zero => 0,
    succ(previous) => 1 + height(previous),
  }
}

predicate SameHeight(before: Nat, after: Nat) {
  constructor root() {
    takes {}
    gives SameHeight(zero, zero);
  }

  constructor under(before: Nat, after: Nat) {
    takes {
      SameHeight(before, after);
    }
    gives SameHeight(succ(before), succ(after));
  }
}

check preserves_ceiling(before: Nat, after: Nat, ceiling: Int) {
  inducts(SameHeight(before, after));
  assumes {
    SameHeight(before, after);
    height(before) <= ceiling;
  }
  ensures {
    height(after) <= ceiling;
  }
}
