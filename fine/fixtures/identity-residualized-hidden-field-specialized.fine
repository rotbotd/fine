enum Flag {
  off,
  on,
}

proof inductive HiddenCopy(value: Flag) {
  hidden_copy(visible: Flag, hidden: Flag)
    takes [same: Id(Flag, hidden, visible)]
    -> HiddenCopy(visible);
}

proof inductive HiddenOff() {
  hidden_off(candidate: Flag)
    takes [is_off: Id(Flag, candidate, off)]
    -> HiddenOff();
}

proof inductive ExplicitHiddenCopy(value: Flag) {
  explicit_hidden_copy(
    visible: Flag,
    hidden: Flag,
    same: Id(Flag, hidden, visible)
  ) -> ExplicitHiddenCopy(visible);
}

function recover_hidden(value: Flag) -> Flag
  takes [evidence: HiddenCopy(value)]
  ensures {
    result == value;
  }
{
  match evidence {
    hidden_copy(shown, erased) => erased,
  }
}

function recover_off() -> Flag
  takes [evidence: HiddenOff()]
  ensures {
    result == off;
  }
{
  // This hidden field is fixed by the constructor's identity demand.
  off // Specialization must retain this trailing comment.
}

function recover_explicit_hidden(value: Flag) -> Flag
  takes [evidence: ExplicitHiddenCopy(value)]
  ensures {
    result == value;
  }
{
  match evidence {
    explicit_hidden_copy(observed, secret, equality) => secret,
  }
}

function recover_explicit_off() -> Flag
  takes [evidence: ExplicitHiddenCopy(off)]
  ensures {
    result == off;
  }
{
  recover_explicit_hidden(off)
}

run identity_residualized_hidden_field {
  proof off_identity: Id(Flag, off, off) = refl(off);
  proof copied: HiddenCopy(off) = hidden_copy(off, off);
  let recovered: Flag = recover_hidden(off);
  assert recovered == off;

  proof hidden_off_value: HiddenOff() = hidden_off(off);
  let recovered_constant: Flag = recover_off();
  assert recovered_constant == off;

  proof explicit_copied: ExplicitHiddenCopy(off)
    = explicit_hidden_copy(off, off, off_identity);
  let recovered_explicit: Flag = recover_explicit_hidden(off);
  assert recovered_explicit == off;

  let recovered_explicit_wrapper: Flag = recover_explicit_off();
  assert recovered_explicit_wrapper == off;
}
