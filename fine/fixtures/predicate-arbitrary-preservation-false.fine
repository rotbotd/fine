// A one-layer preservation theorem through a total constrained constructor field.
// At(value) is a singleton, so the field premise genuinely depends on its binder.
enum Nat {
  zero,
  succ(previous: Nat),
}

view At(expected: Nat) over Nat {
  requires {
    value == expected;
  }
  witness expected;
}

predicate Marked(value: Nat) {
  constructor base() {
    takes {}
    gives Marked(zero);
  }

  constructor grow(value: Nat) {
    takes {
      arbitrary token: At(value) {
        Marked(token);
      }
    }
    gives Marked(succ(succ(value)));
  }
}

predicate Step(before: Nat, after: Nat) {
  constructor root() {
    takes {}
    gives Step(zero, succ(succ(zero)));
  }

  constructor under(before: Nat, after: Nat) {
    takes { Step(before, after); }
    gives Step(succ(succ(before)), succ(succ(after)));
  }
}

check odd_mark_preservation(before: Nat, after: Nat) {
  inducts(Step(before, after));
  assumes {
    Step(before, after);
    Marked(before);
  }
  ensures { Marked(succ(after)); }
}
