enum Tree {
  leaf,
  node(Tree, Tree),
}

proof inductive Grows(tree: Tree) {
  grows_leaf() -> Grows(leaf);
  grows_node(left: Tree, right: Tree)
    takes [left_grows: Grows(left), right_grows: Grows(right)]
    -> Grows(node(left, right));
}

proof inductive Rebuilt(tree: Tree) {
  rebuilt_leaf() -> Rebuilt(leaf);
  rebuilt_node(left: Tree, right: Tree)
    takes [left_rebuilt: Rebuilt(left), right_rebuilt: Rebuilt(right)]
    -> Rebuilt(node(left, right));
}

proof function rebuild(tree: Tree)
  takes [evidence: Grows(tree)]
  inducts(evidence)
  -> Rebuilt(tree) {
  match evidence {
    grows_leaf() => rebuilt_leaf(),
    grows_node[left, right](left_grows, right_grows) =>
      rebuilt_node[left, right](rebuild[left](left_grows), rebuild[right](right_grows)),
  }
}

run proof_inductive_branching_induction {
  proof left: Grows(leaf) = grows_leaf();
  proof right: Grows(leaf) = grows_leaf();
  proof root: Grows(node(leaf, leaf)) = grows_node[leaf, leaf](left, right);
  proof result: Rebuilt(node(leaf, leaf)) = rebuild[node(leaf, leaf)](root);
}
