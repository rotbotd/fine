enum Flag {
  off,
  on,
}

proof inductive OnlyOff(value: Flag) {
  only_off() -> OnlyOff(off);
}

proof inductive NeedsOnlyOff() {
  needs_only_off() takes [available: OnlyOff(off)] -> NeedsOnlyOff();
}

function reject_empty_reachable_indexed_premise() -> Bool
  takes [reachable: NeedsOnlyOff()]
{
  match reachable {
