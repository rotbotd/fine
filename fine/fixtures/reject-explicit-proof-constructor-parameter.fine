enum Nat {
  zero,
  succ(Nat),
}

proof inductive Even(value: Nat) {
  even_zero() -> Even(zero);
  even_next(previous: Nat) takes [prior: Even(previous)] -> Even(succ(succ(previous)));
}

proof inductive Boxed(value: Nat) {
  boxed(value: Nat, evidence: Even(value)) -> Boxed(value);
}

run reject_explicit_proof_constructor_parameter {
  proof zero_even: Even(zero) = even_zero();
  proof bad: Boxed(succ(succ(zero))) = boxed(succ(succ(zero)), zero_even);
}
