function hold(left: Int, right: Int) -> Int
  needs [same: Id(Int, left, right)]
  ensures { result == right; }
{
  left
}

run identity_holes {
  let x: Int = 7;
  let y: Int = 8;
  proof other: Id(Int, y, y) = refl(y);
  proof self: Id(Int, x, x) = refl(x);
  proof copied: Id(Int, x, x) = self;
  let answer: Int = hold(x, x) using [same = self];
  assert answer == x;
}
