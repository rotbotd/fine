// A minimal preservation theorem with a second constructor-generated predicate.
// The recursive branch needs one-step inversion of Marked(succ(succ(before))),
// the Step IH, and constructor introduction for Marked(succ(succ(after))).
enum Nat {
  zero,
  succ(previous: Nat),
}

predicate Marked(value: Nat) {
  constructor base() {
    takes {}
    gives Marked(zero);
  }

  constructor grow(value: Nat) {
    takes {
      Marked(value);
    }
    gives Marked(succ(succ(value)));
  }
}

predicate Step(before: Nat, after: Nat) {
  constructor root() {
    takes {}
    gives Step(zero, succ(succ(zero)));
  }

  constructor under(before: Nat, after: Nat) {
    takes {
      Step(before, after);
    }
    gives Step(succ(succ(before)), succ(succ(after)));
  }
}

check marked_preservation(before: Nat, after: Nat) {
  inducts(Step(before, after));
  assumes {
    Step(before, after);
    Marked(before);
  }
  ensures {
    Marked(after);
  }
}
