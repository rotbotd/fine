enum Nat {
  zero,
  succ(Nat),
}

proof inductive Even(value: Nat) {
  even_zero() -> Even(zero);
  even_next(previous: Nat) takes [prior: Even(previous)] -> Even(succ(succ(previous)));
}

proof inductive Rebuilt(value: Nat) {
  rebuilt_zero() -> Rebuilt(zero);
  rebuilt_next(previous: Nat, prior: Rebuilt(previous)) -> Rebuilt(succ(succ(previous)));
}

proof function rebuild(value: Nat)
  takes [evidence: Even(value)]
  inducts(evidence)
  -> Rebuilt(value) {
  match evidence {
    even_zero() => rebuilt_zero(),
    even_next(previous) => rebuilt_next(previous, rebuild(previous) using [evidence = prior]),
  }
}

run proof_inductive_induction {
  proof zero_even: Even(zero) = even_zero();
  proof rebuilt: Rebuilt(zero) = rebuild(zero) using [evidence = zero_even];
}
