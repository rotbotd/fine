enum Tm {
  atom,
  mark,
  wrap(body: Tm),
}

proof family Step(before: Tm, after: Tm) {
  constructor root() {
    takes {}
    gives Step(atom, mark);
  }

  constructor under(before: Tm, after: Tm) {
    takes {
      Step(before, after);
    }
    gives Step(wrap(before), wrap(after));
  }
}

check distinct_indices(before: Tm, after: Tm) {
  assumes {
    Step(before, after);
  }
  ensures {
    (before == after) == false;
  }
}
