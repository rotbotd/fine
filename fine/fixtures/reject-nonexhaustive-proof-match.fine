enum Nat {
  zero,
  succ(Nat),
}

proof inductive Even(value: Nat) {
  even_zero() -> Even(zero);
  even_next(previous: Nat) takes [prior: Even(previous)] -> Even(succ(succ(previous)));
}

proof function incomplete(value: Nat)
  takes [evidence: Even(value)]
  -> Id(Nat, value, value) {
  match evidence {
    even_zero() => refl(value),
  }
}

run reject_nonexhaustive_proof_match {
}
