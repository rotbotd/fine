enum List {
  nil,
  cons(head: Int, tail: List),
}

function length(xs: List): Int {
  match xs {
    nil => 0,
    cons(_, tail) => 1 + length(tail),
  }
}

function append(xs: List, ys: List): List {
  match xs {
    nil => ys,
    cons(head, tail) => cons(head, append(tail, ys)),
  }
}

proof append_length(xs: List, ys: List) {
  inducts(xs);
  assumes {}
  ensures {
    length(append(xs, ys)) == length(xs) + length(ys);
  }
}

check three_chunk_size(xs: List, ys: List, zs: List) {
  assumes {}
  ensures {
    length(append(append(xs, ys), zs)) ==
      length(xs) + length(ys) + length(zs);
  }
}
